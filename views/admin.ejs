<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio Admin Dashboard | Messages</title>
    <!-- Anti-FOUC Theme Script -->
    <script>
      (function() {
        var savedTheme = localStorage.getItem('portfolio_theme');
        var theme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        var savedAccent = localStorage.getItem('portfolio_accent') || 'green';
        document.documentElement.setAttribute('data-accent', savedAccent);
      })();
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

    <div class="admin-header">
        <div class="admin-header-container">
            <div class="admin-logo">
                <a href="/">Portfo<span class="logo-accent">lio.</span></a>
                <span class="admin-badge">Admin Dashboard</span>
            </div>
            <div class="admin-actions">
                <span class="db-status <%= isMongo ? 'status-mongo' : 'status-json' %>">
                    <i class="fa-solid <%= isMongo ? 'fa-database' : 'fa-file-code' %>"></i>
                    Engine: <%= isMongo ? 'MongoDB' : 'Local JSON DB' %>
                </span>
                <a href="/" class="btn btn-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i> Back to Site</a>
            </div>
        </div>
    </div>

    <main class="admin-main">
        <div class="container">
            <div class="admin-summary-cards">
                <div class="summary-card">
                    <div class="summary-icon"><i class="fa-solid fa-inbox"></i></div>
                    <div class="summary-info">
                        <h3><%= totalMessages %></h3>
                        <p>Total Contact Inquiries</p>
                    </div>
                </div>
                <div class="summary-card">
                    <div class="summary-icon icon-cyan"><i class="fa-solid fa-server"></i></div>
                    <div class="summary-info">
                        <h3>MVC Express</h3>
                        <p>Backend Status Active</p>
                    </div>
                </div>
            </div>

            <div class="admin-messages-box">
                <div class="admin-box-header">
                    <h2><i class="fa-solid fa-envelope-open-text"></i> Received Messages</h2>
                    <span class="msg-count-badge"><%= totalMessages %> Messages</span>
                </div>

                <% if (messages && messages.length > 0) { %>
                    <div class="messages-table-responsive">
                        <table class="messages-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Sender</th>
                                    <th>Subject</th>
                                    <th>Message Body</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% messages.forEach(msg => { %>
                                    <tr id="msgRow-<%= msg._id || msg.id %>">
                                        <td class="col-date">
                                            <%= new Date(msg.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                        </td>
                                        <td class="col-sender">
                                            <strong><%= msg.name %></strong>
                                            <a href="mailto:<%= msg.email %>" class="sender-email"><%= msg.email %></a>
                                        </td>
                                        <td class="col-subject">
                                            <span class="subject-tag"><%= msg.subject %></span>
                                        </td>
                                        <td class="col-message">
                                            <p class="msg-text-content"><%= msg.message %></p>
                                        </td>
                                        <td class="col-action">
                                            <button onclick="deleteMsg('<%= msg._id || msg.id %>')" class="btn-delete" title="Delete Message">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-messages">
                        <i class="fa-solid fa-folder-open empty-icon"></i>
                        <h3>No messages received yet</h3>
                        <p>Submissions sent through the contact form on your portfolio website will appear here.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <script class="admin-js">
        async function deleteMsg(id) {
            if (!confirm('Are you sure you want to delete this message?')) return;
            try {
                const res = await fetch(`/api/messages/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    const row = document.getElementById(`msgRow-${id}`);
                    if (row) {
                        row.style.opacity = '0';
                        setTimeout(() => row.remove(), 300);
                    }
                } else {
                    alert('Error deleting message: ' + data.message);
                }
            } catch(e) {
                alert('Network error deleting message');
            }
        }
    </script>
</body>
</html>
